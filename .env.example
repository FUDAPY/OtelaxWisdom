# ==============================================================================
# OtelaxWisdom-Core - Variables de Entorno de Configuración
# Copiar este archivo a .env y definir las credenciales del entorno
# ==============================================================================

# Configuración del Backend
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL + pgvector
POSTGRES_USER=otelax_admin
POSTGRES_PASSWORD=cambiar_este_password_seguro
POSTGRES_DB=otelax_wisdom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Neo4j Graph Database
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_este_password_seguro
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Formato requerido por el contenedor oficial: <usuario>/<contraseña>
NEO4J_AUTH=neo4j/cambiar_este_password_seguro

# Proveedor de Embeddings & LLM (Local vía Ollama o Cloud API)
EMBEDDING_PROVIDER=ollama # Opciones: ollama | openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3:8b
OPENAI_API_KEY=
